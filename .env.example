# Copy this file to .env.local (preferred, gitignored) or .env, then fill in
# your API keys. Then just run: npm start

# MarketData.app — REQUIRED. Primary provider for stock prices, quotes and
# options chains (screening, options analysis, historical backfill).
MARKET_DATA_API_KEY=

# Fundamentals providers used by stock analysis (optional).
TWELVE_DATA_API_KEY=
EODHD_API_KEY=

# Data API server (npm run data-api) — read-only HTTP access to articles.db,
# meant to sit behind the Cloudflare tunnel (manzanaresgate). Token is required.
# On the server machine: set DATA_API_TOKEN and run `npm run data-api`.
# On the laptop: set DATA_API_URL + DATA_API_TOKEN and query over HTTPS.
DATA_API_TOKEN=
DATA_API_PORT=8788
# DATA_API_URL=https://data.manzanaresgate.com

